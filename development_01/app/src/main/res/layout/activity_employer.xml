<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/employer_role"
        android:layout_width="97dp"
        android:layout_height="43dp"
        android:layout_marginStart="166dp"
        android:layout_marginEnd="148dp"
        android:text="Post a Job"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:layout_editor_absoluteY="41dp" />

    <TextView
        android:id="@+id/fixedEmployerName"
        android:layout_width="116dp"
        android:layout_height="30dp"
        android:layout_marginTop="32dp"
        android:text="User Name"
        app:layout_constraintTop_toBottomOf="@+id/employer_role"
        tools:layout_editor_absoluteX="9dp" />

    <TextView
        android:id="@+id/fixedEmployerEmail"
        android:layout_width="116dp"
        android:layout_height="30dp"

        android:layout_marginTop="20dp"
        android:text="Employer Email"
        app:layout_constraintTop_toBottomOf="@+id/fixedEmployerName"
        tools:layout_editor_absoluteX="9dp" />

    <Button
        android:id="@+id/employerLogOut"
        android:layout_width="119dp"
        android:layout_height="51dp"
        android:layout_marginStart="118dp"
        android:layout_marginTop="500dp"
        android:layout_marginEnd="174dp"
        android:text="Log Out"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/employer_role" />

    <TextView
        android:id="@+id/employerEmail"
        android:layout_width="230dp"
        android:layout_height="30dp"
        android:layout_marginStart="28dp"
        android:layout_marginTop="20dp"
        android:text="TextView"
        app:layout_constraintStart_toEndOf="@+id/fixedEmployerEmail"
        app:layout_constraintTop_toBottomOf="@+id/employerName" />

    <TextView
        android:id="@+id/employerName"
        android:layout_width="225dp"
        android:layout_height="30dp"
        android:layout_marginStart="28dp"
        android:layout_marginTop="32dp"
        android:text="TextView"
        app:layout_constraintStart_toEndOf="@+id/fixedEmployerName"
        app:layout_constraintTop_toBottomOf="@+id/employer_role" />

</androidx.constraintlayout.widget.ConstraintLayout>